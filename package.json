{
	"name": "vgpu-tesseract-demo",
	"version": "1.0.0",
	"description": "A password-reactive 4D tesseract rendered with WebGPU and vGPU.",
	"type": "module",
	"license": "MIT",
	"packageManager": "bun@1.4.0",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview",
		"test": "bun test",
		"check": "biome check . && tsc --noEmit",
		"format": "biome format --write .",
		"shader:check": "vgpu check src/tesseract.wgsl --require-validation"
	},
	"dependencies": {
		"@fontsource-variable/geist": "5.3.0",
		"@fontsource-variable/geist-mono": "5.3.0",
		"vgpu": "0.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@types/bun": "1.4.0",
		"typescript": "7.0.2",
		"vite": "8.2.2"
	},
	"trustedDependencies": [
		"@vgpu/adapter-node",
		"webgpu"
	]
}
